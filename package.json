{
  "name": "game",
  "version": "1.0.0",
  "description": "A Persian third-person 3D city game: find Robot Market vending machines across real Mashhad streets",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\" \"tests/**/*.js\" vite.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,md}\" \"tests/**/*.js\" vite.config.js",
    "predev": "npm run format",
    "prebuild": "npm run format",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^6.4.3"
  }
}
